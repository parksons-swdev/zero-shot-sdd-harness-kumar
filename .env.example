AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Override model (uses provider default when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6   (Anthropic default)
# AGENT_LLM_MODEL=gemini-3.1-pro       (Gemini default)

# Set exactly ONE provider key:
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# Per-node model overrides (CSV Insight Agent) — fast/cheap vs quality-critical nodes.
# Defaults: fast=gemini-2.5-flash, quality=gemini-3.1-pro
# AGENT_LLM_MODEL_FAST=gemini-2.5-flash
# AGENT_LLM_MODEL_QUALITY=gemini-3.1-pro

# Dataset upload settings
# AGENT_UPLOAD_DIR=./data/uploads
# AGENT_MAX_UPLOAD_MB=100

# Optional: LangSmith tracing (observability)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

PORT=8001
